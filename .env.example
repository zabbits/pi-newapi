# Alternatively, use /login newapi to save the gateway URL and token in pi.
# Export these values before starting pi; this file is not loaded automatically.
NEWAPI_BASE_URL=https://newapi.example.com
NEWAPI_API_KEY=sk-replace-me
# Optional allowlist. Discovery is still used to retain model metadata.
# NEWAPI_MODELS=my-chat-model,another-chat-model
# Explicit global protocol override; prefer per-model overrides for mixed gateways.
# NEWAPI_API=openai-responses
# Optional configuration path (default: pi's agent directory/newapi.json).
# NEWAPI_CONFIG=/absolute/path/to/newapi.json
# Optional fallback limits for unknown models only.
# NEWAPI_CONTEXT_WINDOW=32768
# NEWAPI_MAX_TOKENS=4096
